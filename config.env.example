# Copy this file to config.env and fill in your IBM watsonx.ai credentials.
# NEVER commit config.env to version control.

IBM_API_KEY=your_ibm_watsonx_api_key_here
IBM_PROJECT_ID=your_project_id_here
IBM_ENDPOINT_URL=https://au-syd.ml.cloud.ibm.com

# Flask secret key — use a long random string in production
FLASK_SECRET_KEY=change-me-to-a-long-random-secret

# Paths (defaults shown — change only if needed)
CHROMA_PERSIST_DIR=./chroma_db
DOCUMENTS_DIR=./documents
